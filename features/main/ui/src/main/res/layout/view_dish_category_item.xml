<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_card_dish_category_divider_margin"
    android:background="@color/white"
    android:elevation="@dimen/item_card_elevation"
    app:cardCornerRadius="@dimen/item_card_corner_radius">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDishCategory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_card_dish_category_img_height"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tvDishCategoryName"
        style="@style/BaseTextStyle.Medium.Large"
        android:layout_width="220dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        tools:text="Пекарни и кондитерское" />
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_card_dish_height"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_card_dish_width"
        android:background="@color/white"
        app:cardBackgroundColor="@color/surface_F8F7F5"
        app:cardCornerRadius="@dimen/item_card_corner_radius">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDish"
            android:layout_width="@dimen/item_card_dish_img_size"
            android:layout_gravity="center"
            android:layout_height="@dimen/item_card_dish_img_size"
            tools:src="@tools:sample/backgrounds/scenic" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvDishDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        style="@style/BaseTextStyle"
        tools:text="Салат по восточному"
        android:maxLines="2" />

</androidx.appcompat.widget.LinearLayoutCompat>
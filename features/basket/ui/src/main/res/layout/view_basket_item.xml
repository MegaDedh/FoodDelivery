<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/spacing_4"
    android:layout_height="@dimen/item_basket_height">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewBasket"
        android:layout_width="@dimen/item_basket_height"
        android:layout_height="@dimen/item_basket_height"
        android:background="@color/white"
        app:cardBackgroundColor="@color/surface_F8F7F5"
        app:cardCornerRadius="@dimen/item_card_basket_corner_radius"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBasketDish"
            android:layout_width="@dimen/item_basket_card_dish_img_size"
            android:layout_height="@dimen/item_basket_card_dish_img_size"
            android:layout_gravity="center"
            tools:src="@tools:sample/backgrounds/scenic" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvBasketDishName"
        style="@style/BaseTextStyle"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@id/tvBasketPrice"
        app:layout_constraintStart_toEndOf="@+id/cardViewBasket"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Рыба с овощами и рисом" />

    <TextView
        android:id="@+id/tvBasketPrice"
        style="@style/BaseTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvBasketDishName"
        app:layout_constraintTop_toBottomOf="@id/tvBasketDishName"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="799 ₽" />

    <TextView
        android:id="@+id/tvBasketWeight"
        style="@style/BaseTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/grayscale2_80000000"
        app:layout_constraintStart_toEndOf="@+id/tvBasketPrice"
        app:layout_constraintTop_toTopOf="@id/tvBasketPrice"
        tools:text="· 560 г" />

    <TextView
        android:id="@+id/tvBasketQuantity"
        style="@style/BaseTextStyle.Medium"
        android:layout_width="100dp"
        android:layout_height="32dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/shape_round"
        android:layout_marginEnd="@dimen/spacing_16"
        tools:text="42" />

    <ImageView
        android:id="@+id/ivBasketMinus"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_6"
        android:src="@drawable/ic_minus"
        app:layout_constraintBottom_toBottomOf="@+id/tvBasketQuantity"
        app:layout_constraintStart_toStartOf="@+id/tvBasketQuantity"
        app:layout_constraintTop_toTopOf="@+id/tvBasketQuantity" />

    <ImageView
        android:id="@+id/ivBasketPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_6"
        android:src="@drawable/ic_plus"
        app:layout_constraintBottom_toBottomOf="@+id/tvBasketQuantity"
        app:layout_constraintEnd_toEndOf="@+id/tvBasketQuantity"
        app:layout_constraintTop_toTopOf="@+id/tvBasketQuantity" />

</androidx.constraintlayout.widget.ConstraintLayout>
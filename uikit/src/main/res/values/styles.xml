<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--Toolbar-->
    <style name="Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
    </style>

    <style name="ToolbarIcon">
        <item name="android:layout_width">@dimen/toolbar_icon_size</item>
        <item name="android:layout_height">@dimen/toolbar_icon_size</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="ToolbarTitle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/toolbar_text_size</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="ToolbarDate">
        <item name="android:textColor">@color/grayscale2_80000000</item>
        <item name="android:textSize">@dimen/toolbar_date_size</item>
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <!--TextStyle-->
    <style name="BaseTextStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="BaseTextStyle.Medium" parent="BaseTextStyle">
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/text_size_14</item>
    </style>

    <style name="BaseTextStyle.Medium.16" parent="BaseTextStyle">
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/text_size_16</item>
    </style>

    <style name="BaseTextStyle.Medium.Large" parent="BaseTextStyle.Medium">
        <item name="android:textSize">@dimen/text_size_20</item>
    </style>

    <!--BottomNavigationView-->
    <style name="Widget.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextActivate</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextInactivate</item>
    </style>

    <style name="BottomNavigationTextActivate">
        <item name="fontFamily">@font/sf_pro_display_medium</item>
    </style>


    <style name="ButtonTag" >
        <item name="backgroundTint">@drawable/btn_background_selector</item>
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
        <item name="android:textColor">@color/tag_button_text_color</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Button -->
    <style name="PrimaryButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_blue_3364E0</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BottomNavigationTextInactivate" parent="BottomNavigationTextActivate" />
</resources>